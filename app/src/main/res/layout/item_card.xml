<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="100"
    android:baselineAligned="false"
    android:minHeight="50dp"
    android:orientation="horizontal">

    <com.chauthai.swipereveallayout.SwipeRevealLayout
        android:id="@+id/swipe_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="44"
        app:dragEdge="right"
        app:mode="same_level">

        <LinearLayout
            android:id="@+id/backgroundButtons"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_weight="90"
            android:paddingStart="8dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:minHeight="50dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/visibleBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30"
                android:background="@color/chek3"
                android:contentDescription="@string/visibility_btn"
                android:padding="13dp"
                app:srcCompat="@drawable/ic_visibility"
                app:tint="@color/White" />

            <ImageView
                android:id="@+id/editBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30"
                android:background="@color/chek3"
                android:contentDescription="@string/edit_btn"
                android:padding="13dp"
                app:srcCompat="@drawable/ic_edit"
                app:tint="@color/White" />

            <ImageView
                android:id="@+id/deleteBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30"
                android:contentDescription="@string/delete_btn"
                android:padding="13dp"
                android:background="@drawable/rounded_shape_one_side"
                app:srcCompat="@drawable/ic_delete"
                app:tint="@color/White" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/drag_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="50dp"
            android:weightSum="0">

            <ImageView
                android:id="@+id/visibleBtnOnStart"
                android:visibility="gone"
                style="@style/CalendarIcon"
                android:contentDescription="@string/visibility_btn"
                app:srcCompat="@drawable/ic_visibility"
                app:tint="@color/White" />

            <TextView
                android:id="@+id/title"
                style="@style/TitleMedium"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/money"
                style="@style/TitleMediumEnd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="4"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/card_balance_hint" />
        </LinearLayout>
    </com.chauthai.swipereveallayout.SwipeRevealLayout>
</LinearLayout>
