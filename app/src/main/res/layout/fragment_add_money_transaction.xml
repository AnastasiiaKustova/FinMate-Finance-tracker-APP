<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.add.AddMoneyTransaction">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <FrameLayout
            style="@style/HeaderLayout"
            android:padding="20dp">

            <ImageView
                android:id="@+id/backButton"
                style="@style/ButtonBack"
                android:contentDescription="@string/back_btn" />

            <TextView
                android:id="@+id/title"
                style="@style/CenterTitle"
                android:text="@string/new_transaction" />

        </FrameLayout>

        <LinearLayout style="@style/RoundedGreyLayoutNoTopMargin">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <EditText
                    android:id="@+id/moneyText"
                    style="@style/NumberEditText"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textCurrency"
                    style="@style/CurrencyText"
                    app:layout_constraintBottom_toBottomOf="@+id/moneyText"
                    app:layout_constraintStart_toEndOf="@+id/moneyText"
                    app:layout_constraintTop_toTopOf="@+id/moneyText" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView style="@style/SeparatorLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/cardFromText"
                            style="@style/TitleForEditText"
                            android:text="@string/transaction_from" />

                        <Spinner
                            android:id="@+id/cardFrom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:minHeight="48dp" />

                        <TextView
                            android:id="@+id/cardToText"
                            style="@style/TitleForEditText"
                            android:layout_marginTop="12dp"
                            android:text="@string/transaction_to" />

                        <Spinner
                            android:id="@+id/cardTo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp" />

                        <TextView
                            android:id="@+id/dateText"
                            style="@style/TitleForEditText"
                            android:layout_marginTop="12dp"
                            android:text="@string/operation_date" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/icCalendar"
                                style="@style/CalendarIcon" />

                            <TextView
                                android:id="@+id/editDateText"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/commentText"
                            style="@style/TitleForEditText"
                            android:layout_marginTop="16dp"
                            android:text="@string/comment" />

                        <EditText
                            android:id="@+id/comment"
                            style="@style/TextEditText"
                            android:layout_marginTop="10dp"
                            android:hint="@string/comment_hint"
                            android:paddingHorizontal="8dp" />
                    </LinearLayout>
                </ScrollView>

                <Button
                    android:id="@+id/addButton"
                    style="@style/ButtonMain"
                    android:text="@string/create_btn" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>