        <item name="textInputStyle">@style/CustomDateInput</item>
        <item name="buttonBarPositiveButtonStyle">@style/ButtonsPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/ButtonsNegative</item>

        <item name="android:textColorPrimary">@color/White</item>
        <item name="colorPrimary">@color/BG60</item>
