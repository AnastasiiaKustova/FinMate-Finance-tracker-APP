<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TitleHuge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TitleLarge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TitleMedium" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="TitleMediumEnd" parent="TitleMedium">
        <item name="android:textAlignment">viewEnd</item>
    </style>

    <style name="Explanation" parent="BodyMedium">
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/White60</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <style name="BodyMedium" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/White60</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="BodySmall" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/White60</item>
    </style>
    <style name="LabelSmall" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
    </style>



    <style name="ImageButton" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:scaleX">1.7</item>
        <item name="android:scaleY">1.7</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_height">56dp</item>
    </style>

    <style name="ButtonWithText" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:background">@color/transparent</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/White60</item>
        <item name="android:textSize">11sp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="CenterTitle" parent="TitleHuge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TitleForEditText" parent="TitleLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextEditText" parent="BodyMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/rounded_text_field</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:inputType">text</item>

        <item name="android:textColor">@color/White</item>
        <item name="android:textColorHint">@color/Hint</item>
        <item name="android:ems">10</item>
    </style>

    <style name="NumberEditText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:textColorHighlight">@color/White</item>
        <item name="android:hint">@string/transaction_hint</item>
        <item name="android:textColorHint">@color/LightGrey</item>
        <item name="android:textColorLink">@color/Grey60</item>
        <item name="android:textSize">48sp</item>
        <item name="android:maxLength">11</item>
    </style>

    <style name="CurrencyText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">6dp</item>
        <item name="android:text">@string/currency</item>
        <item name="android:textSize">40sp</item>
    </style>
</resources>